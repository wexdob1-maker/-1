import java.util.Random;
import java.util.Scanner;

public class RandomNumbersDemo {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        System.out.print("Введите количество случайных чисел: ");
        if (!scanner.hasNextInt()) {
            System.out.println("Ошибка: нужно ввести целое число.");
            scanner.close();
            return;
        }
        int count = scanner.nextInt();

        if (count <= 0) {
            System.out.println("Количество должно быть больше нуля.");
            scanner.close();
            return;
        }

        // Вывод с переходом на новую строку (println)
        System.out.println("\nСлучайные числа (каждое с новой строки):");
        for (int i = 0; i < count; i++) {
            System.out.println(random.nextInt(100)); // числа от 0 до 99
        }

        // Вывод без перехода на новую строку (print)
        System.out.print("\nСлучайные числа (в одну строку): ");
        for (int i = 0; i < count; i++) {
            System.out.print(random.nextInt(100) + " ");
        }
        System.out.println(); // финальный перевод строки для чистоты вывода

        scanner.close();
    }
}
